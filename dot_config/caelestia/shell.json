{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "clock": {
            "background": true,
            "showDate": true
        },
        "persistent": true,
        "status": {
            "showAudio": true,
            "showBattery": false,
            "showKbLayout": false,
            "showLockStatus": false,
            "showMicrophone": true,
            "showWifi": false
        },
        "tray": {
            "background": true,
            "compact": false,
            "recolour": false
        },
        "workspaces": {
            "activeTrail": false,
            "maxWindowIcons": 5,
            "occupiedBg": false,
            "showWindows": false,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 10
        }
    },
    "general": {
        "apps": {
            "terminal": [
                "/usr/bin/ghostty",
                "--gtk-single-instance=true"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 180
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 300
                }
            ]
        }
    },
    "services": {
        "useFahrenheit": false,
        "useTwelveHourClock": false
    }
}
